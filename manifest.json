{
  "manifest_version": 3,
  "name": "随译",
  "version": "0.2.42",
  "description": "右侧悬浮窗一键沉浸式翻译网页，译文以原文同款样式嵌在原文下方，接入 DeepSeek。",
  "permissions": ["storage", "activeTab", "scripting", "contextMenus"],
  "host_permissions": ["https://api.deepseek.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content_guard.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "随译",
    "default_popup": "panel.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "panel.html",
    "open_in_tab": false
  },
  "web_accessible_resources": [
    {
      "resources": ["content_main.js", "styles/inject.css"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
